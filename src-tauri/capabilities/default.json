{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "gemini",
          "cmd": "gemini",
          "args": true
        },
        {
          "name": "claude",
          "cmd": "claude",
          "args": true
        },
        {
          "name": "goose",
          "cmd": "goose",
          "args": true
        },
        {
          "name": "codex",
          "cmd": "codex",
          "args": true
        },
        {
          "name": "opencode",
          "cmd": "/Users/mekopa/.opencode/bin/opencode",
          "args": true
        }
      ]
    },
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "name": "gemini",
          "cmd": "gemini",
          "args": true
        },
        {
          "name": "claude",
          "cmd": "claude",
          "args": true
        },
        {
          "name": "goose",
          "cmd": "goose",
          "args": true
        },
        {
          "name": "codex",
          "cmd": "codex",
          "args": true
        },
        {
          "name": "opencode",
          "cmd": "/Users/mekopa/.opencode/bin/opencode",
          "args": true
        }
      ]
    },
    "shell:allow-stdin-write",
    "shell:allow-kill"
  ]
}
